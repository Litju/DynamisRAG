# Local development environment for DynamisRAG.
#
# Copy this file to `.env` before the first run:
#
#     Copy-Item .env.example .env
#
# `.env` is git-ignored and must never be committed. Compose reads this file
# for container variables, and the application reads the `DYNAMISRAG_*` entries
# for its own configuration, so both agree on a single source of truth.
#
# SECURITY: the passwords below are published, local-only development values.
# They exist so that `docker compose up -d` works immediately on a workstation
# with nothing secret in version control. The services are bound to 127.0.0.1
# only. Never reuse these values for a shared environment, a CI secret you care
# about, or any managed service.

# ---------------------------------------------------------------- application
DYNAMISRAG_ENVIRONMENT=local
DYNAMISRAG_HOST=127.0.0.1
DYNAMISRAG_PORT=8000
DYNAMISRAG_LOG_LEVEL=INFO
# Upper bound for each readiness dependency probe, in seconds.
DYNAMISRAG_DEPENDENCY_TIMEOUT_SECONDS=5

# ------------------------------------------------------------- postgresql 18
# Host port 55432 (container port 5432). A workstation that already runs a local
# PostgreSQL on 5432 can still start this stack; see compose.yaml.
DYNAMISRAG_POSTGRES_USER=dynamisrag
DYNAMISRAG_POSTGRES_DB=dynamisrag
DYNAMISRAG_POSTGRES_PASSWORD=local-dev-only-postgres-1A
# Plain `postgresql://` on purpose: the psycopg 3 driver is attached in code by
# `dynamisrag.config.to_sqlalchemy_url`, so the scheme is stated in one place.
DYNAMISRAG_DATABASE_URL=postgresql://dynamisrag:local-dev-only-postgres-1A@127.0.0.1:55432/dynamisrag

# Integration uses compose.integration.yaml: project dynamisrag-integration,
# separate named volumes, PostgreSQL host port 55433, Qdrant 16333, and
# OpenSearch 19200. During an integration run, set DYNAMISRAG_DATABASE_URL to
# port 55433 and DYNAMISRAG_OPENSEARCH_URL to port 19200; the development stack
# remains on ports 55432, 6333, and 9200.
# Generate the test password per run. The admin DSN must use the isolated
# cluster's superuser and both DSNs must name its postgres database.
# DYNAMISRAG_DATABASE_URL=postgresql://dynamisrag:<admin-password>@127.0.0.1:55433/dynamisrag
# DYNAMISRAG_TEST_DATABASE_URL=postgresql://dynamisrag_test:<hex-password>@127.0.0.1:55433/postgres
# DYNAMISRAG_TEST_ADMIN_DATABASE_URL=postgresql://dynamisrag:<admin-password>@127.0.0.1:55433/postgres
# Also set DYNAMISRAG_SCIENTIFIC_QDRANT_URL=http://127.0.0.1:16333 for integration.
# Set the cluster identity after starting the integration Compose project by reading
# pg_control_system().system_identifier from its postgres container.
# DYNAMISRAG_TEST_CLUSTER_SYSTEM_IDENTIFIER=<unsigned-decimal-system-id>

# -------------------------------------------------------------- opensearch 3
# The official image enables the security plugin, which serves HTTPS on 9200
# with a self-signed demo certificate. Plain HTTP is refused, so the scheme
# below is required. Set DYNAMISRAG_OPENSEARCH_VERIFY_TLS=true once a trusted
# certificate is provisioned.
DYNAMISRAG_OPENSEARCH_URL=https://127.0.0.1:9200
DYNAMISRAG_OPENSEARCH_USERNAME=admin
DYNAMISRAG_OPENSEARCH_PASSWORD=local-dev-only-opensearch-1A
DYNAMISRAG_OPENSEARCH_VERIFY_TLS=false

# The stable query target of the passage projection. Queries address the alias,
# never a physical index, so a verified rebuild can be cut over atomically
# without interrupting readers. The name is also part of every physical index
# index name, so changing it gives an isolated namespace.
DYNAMISRAG_OPENSEARCH_INDEX_ALIAS=dynamisrag-passages

# ------------------------------------------------------- embeddings (optional)
#
# NONE of the above depends on any of this. A Text Embeddings Inference server is
# not required for `dynamisrag`, `/healthz`, `/readyz` or BM25, and the readiness
# probe does not treat a missing model server as a degraded dependency: until a
# later feature activates embeddings, a project without one is complete.
#
# The three values below are the *identity* the deployment insists on. Unset by
# default, and a partial set fails loudly rather than recording whatever the
# server happened to be serving.
#
# `DYNAMISRAG_TEI_MODEL_SHA` must be an immutable Hugging Face Hub commit id --
# 40 lowercase hexadecimal characters, as in `.../api/models/<id>`. A tag, a
# branch or `latest` names a moving target, and vectors generated under one could
# neither be regenerated nor compared with anything later.
#
# Plain `http://`, because the reference container in `compose.embedding.yaml`
# serves plaintext HTTP on host port 8080 (container port 80). This is not a
# choice to skip transport security: it is loopback-only, and it is the scheme the
# server actually speaks. HTTPS is fully supported for an external deployment --
# point this at `https://...` and leave `DYNAMISRAG_TEI_VERIFY_TLS=true` once a
# trusted certificate is provisioned. Note that `VERIFY_TLS=false` only disables
# certificate *verification*; it does not make an HTTPS URL speak plaintext, so
# pairing `https://` with `false` against a plaintext server is a connection
# failure, not a downgrade.
DYNAMISRAG_TEI_URL=http://127.0.0.1:8080
DYNAMISRAG_TEI_MODEL_ID=
DYNAMISRAG_TEI_MODEL_SHA=
# Provisional RES-139 engineering profile; not a statistically proven winner.
# Formal RES-138 Stage-B production qualification deferred.
# Uncomment to enable /retrieve with the current provisional profile.
# DYNAMISRAG_TEI_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
# DYNAMISRAG_TEI_MODEL_SHA=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3

# Only needed for a TEI started with `--api-key`. Never logged or rendered.
# DYNAMISRAG_TEI_API_KEY=
# Only consulted for an `https://` URL. Leave it false for the plaintext loopback
# reference deployment above; it is meaningless there and setting it true would
# not change anything.
DYNAMISRAG_TEI_VERIFY_TLS=false
# Embedding batches are real forward passes on a possibly cold CPU backend, so
# this is far more generous than the readiness probe timeout above.
DYNAMISRAG_TEI_TIMEOUT_SECONDS=30
# Inputs per /embed request. A value above the server's advertised
# max_client_batch_size fails the run; it is never silently shrunk, because the
# request partition is part of a reproducible run.
DYNAMISRAG_TEI_BATCH_SIZE=32
# Total attempts per request, including the first. Linear backoff, no jitter.
DYNAMISRAG_TEI_MAX_ATTEMPTS=3
DYNAMISRAG_TEI_RETRY_BACKOFF_SECONDS=0.5

# Read by compose.embedding.yaml, never by the application.
DYNAMISRAG_TEI_VERSION=1.9.4
DYNAMISRAG_TEI_MAX_CLIENT_BATCH_SIZE=32

# LIVE-RAG-001: independent opt-in Qdrant API over the retained scientific corpus.
# Does not change /retrieve or enable any ingestion, publication or model download.
DYNAMISRAG_SCIENTIFIC_QDRANT_ENABLED=false
DYNAMISRAG_SCIENTIFIC_ANSWERS_ENABLED=false
DYNAMISRAG_SCIENTIFIC_OLLAMA_URL=http://127.0.0.1:11434
DYNAMISRAG_SCIENTIFIC_QDRANT_URL=http://127.0.0.1:6333
DYNAMISRAG_SCIENTIFIC_TEI_URL=http://127.0.0.1:8081
# DYNAMISRAG_SCIENTIFIC_EVIDENCE_DIRECTORY=docs/evidence/real-science-v1

# ---------------------------------------------------------------------------
# RES-637 conversational research agent (/api/v2). OFF by default and fail-closed:
# enabling it requires an identity secret and a DEDICATED agent database. The service refuses to
# start if the agent database is the canonical database above. Contract:
# docs/res637-eve-python-contract.md. Do NOT put real credentials in this file.
# ---------------------------------------------------------------------------
DYNAMISRAG_AGENT_ENABLED=false
# Dedicated agent database (threads, runs, events, LangGraph checkpoints). Not DYNAMISRAG_DATABASE_URL.
# DYNAMISRAG_AGENT_DATABASE_URL=postgresql://agent_user:change-me@127.0.0.1:55432/dynamisrag_agent
# Non-production only: in-memory store (never durable, refused in staging/production).
# DYNAMISRAG_AGENT_ALLOW_EPHEMERAL_STORE=false
# Shared HMAC secret (>= 32 chars) used to verify signed identity assertions from the Eve server.
# DYNAMISRAG_AGENT_IDENTITY_SECRET=
# DYNAMISRAG_AGENT_IDENTITY_PREVIOUS_SECRET=
DYNAMISRAG_AGENT_IDENTITY_ISSUER=dynamis-eve
DYNAMISRAG_AGENT_IDENTITY_AUDIENCE=dynamisrag-agent-v2
# Non-production only: accept an UNSIGNED X-Dynamis-User-Id header. Refused in staging/production.
# DYNAMISRAG_AGENT_DEV_IDENTITY_HEADER_ENABLED=false
# Workers: in-process threads (0 disables) and/or `python -m dynamisrag.agent.worker` processes.
DYNAMISRAG_AGENT_INLINE_WORKERS=1
DYNAMISRAG_AGENT_RUN_TIMEOUT_SECONDS=300
DYNAMISRAG_AGENT_LEASE_SECONDS=30
DYNAMISRAG_AGENT_MAX_RUN_ATTEMPTS=3
# Model: ollama | openai | anthropic | opencode_go | deterministic (tests only).
DYNAMISRAG_AGENT_PROVIDER=ollama
DYNAMISRAG_AGENT_MODEL_NAME=qwen3:4b
DYNAMISRAG_AGENT_MODEL_BASE_URL=http://127.0.0.1:11435
# DYNAMISRAG_AGENT_MODEL_API_KEY=
# OpenCode Go usage rights for a public research assistant are UNVERIFIED. Leave false until the
# owner holds written confirmation from OpenCode; the provider is refused otherwise.
DYNAMISRAG_AGENT_OPENCODE_GO_USAGE_APPROVED=false
# LangSmith: off by default; enabling requires a key. structure_only exports no content.
DYNAMISRAG_AGENT_LANGSMITH_TRACING_ENABLED=false
DYNAMISRAG_AGENT_LANGSMITH_MODE=structure_only
# DYNAMISRAG_AGENT_LANGSMITH_API_KEY=
