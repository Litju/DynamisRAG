# Put actual settings in ~/.dynamisrag/res638-local/settings.env, outside Git.
# Database and Qdrant values must be generated hex strings and match the owner volumes.
RESEARCH_ADMIN_PASSWORD=
RESEARCH_OWNER_PASSWORD=
RESEARCH_AGENT_PASSWORD=
RESEARCH_READER_PASSWORD=
RESEARCH_QDRANT_KEY=
RESEARCH_TEI_CACHE_VOLUME=dynamisrag-research-edition_tei-model-cache
RESEARCH_TEI_CACHE_EXTERNAL=true
DYNAMISRAG_AGENT_IDENTITY_SECRET=
WORKSPACE_SESSION_SECRET=
# JSON mapping the owner username to the salt:hash from apps/workspace/scripts/account.mjs.
WORKSPACE_ACCOUNTS='{}'

# Enable only under the existing owner-approved local use scope.
DYNAMISRAG_AGENT_OPENCODE_GO_USAGE_APPROVED=false
DYNAMISRAG_AGENT_MODEL_API_KEY=
DYNAMISRAG_AGENT_RUN_COST_BUDGET_USD=0.20
DYNAMISRAG_AGENT_RUN_TOKEN_BUDGET=250000
DYNAMISRAG_AGENT_RUN_TIMEOUT_SECONDS=1200
DYNAMISRAG_AGENT_LEASE_SECONDS=90
DYNAMISRAG_RESEARCH_MAX_PAPERS=2
DYNAMISRAG_RESEARCH_ACQUISITION_DEADLINE_SECONDS=900
LOCAL_WORKSPACE_PORT=3040
