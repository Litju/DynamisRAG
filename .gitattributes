# Normalise line endings so a Windows checkout and a Linux CI runner see the same
# bytes. Without this, `core.autocrlf=true` rewrites every text file in the
# Windows working tree and the repository slowly diverges between platforms.
* text=auto eol=lf

# Windows-native scripts stay CRLF, which is what cmd.exe and PowerShell expect.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep these unambiguously binary so Git never attempts EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.whl binary
