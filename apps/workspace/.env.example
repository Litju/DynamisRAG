# Server-only. Use a new identity secret shared ONLY with this workspace's Python API.
DYNAMISRAG_AGENT_IDENTITY_SECRET=
DYNAMISRAG_API_ORIGIN=https://your-dedicated-python-host.example
# Restricted preview accounts, hashed with node:crypto scryptSync(password,salt,64).
# Use the account hash helper in scripts/account.mjs. Never use test credentials on a host.
WORKSPACE_ACCOUNTS={}
# Display-only status; never changes the Python inference authorization gate.
NEXT_PUBLIC_RESEARCH_MODE=unqualified
# Normally unset: withEve routes to its own deployed service.
# EVE_INTERNAL_ORIGIN=
