# Copy to .env in a clean checkout and use compose.research-edition.yaml.
# Published local-only credentials; bind every service to loopback.
DYNAMISRAG_ENVIRONMENT=local
DYNAMISRAG_HOST=127.0.0.1
DYNAMISRAG_PORT=8001
DYNAMISRAG_LOG_LEVEL=INFO
DYNAMISRAG_DEPENDENCY_TIMEOUT_SECONDS=5

# The research project has a new volume namespace and non-default ports.
DYNAMISRAG_POSTGRES_USER=dynamisrag
DYNAMISRAG_POSTGRES_DB=dynamisrag
DYNAMISRAG_POSTGRES_PASSWORD=local-research-admin-1A
DYNAMISRAG_RESEARCH_OWNER_PASSWORD=local-research-owner-1A
DYNAMISRAG_POSTGRES_HOST_PORT=55434
DYNAMISRAG_QDRANT_HOST_PORT=16334
DYNAMISRAG_OPENSEARCH_HOST_PORT=19201
DYNAMISRAG_OLLAMA_HOST_PORT=11435

# Application credentials use a dedicated non-superuser owner.
DYNAMISRAG_DATABASE_URL=postgresql://dynamisrag_owner:local-research-owner-1A@127.0.0.1:55434/dynamisrag_research
DYNAMISRAG_OPENSEARCH_URL=https://127.0.0.1:19201
DYNAMISRAG_OPENSEARCH_USERNAME=admin
DYNAMISRAG_OPENSEARCH_PASSWORD=local-research-search-1A
DYNAMISRAG_OPENSEARCH_VERIFY_TLS=false
DYNAMISRAG_OPENSEARCH_INDEX_ALIAS=dynamisrag-passages

# The app reads the packaged local JATS corpus and its versioned vector receipts.
DYNAMISRAG_SCIENTIFIC_QDRANT_ENABLED=true
DYNAMISRAG_SCIENTIFIC_ANSWERS_ENABLED=true
DYNAMISRAG_SCIENTIFIC_EVIDENCE_DIRECTORY=docs/evidence/real-science-v1
DYNAMISRAG_SCIENTIFIC_QDRANT_URL=http://127.0.0.1:16334
DYNAMISRAG_SCIENTIFIC_TEI_URL=http://127.0.0.1:8082
DYNAMISRAG_SCIENTIFIC_OLLAMA_URL=http://127.0.0.1:11435

# Pinned Qwen3 embedding service used for query identity and retrieval.
DYNAMISRAG_TEI_URL=http://127.0.0.1:8082
DYNAMISRAG_TEI_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
DYNAMISRAG_TEI_MODEL_SHA=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
DYNAMISRAG_TEI_VERSION=1.9.4
DYNAMISRAG_TEI_HOST_PORT=8082
DYNAMISRAG_TEI_MAX_CLIENT_BATCH_SIZE=1
DYNAMISRAG_TEI_VERIFY_TLS=false
