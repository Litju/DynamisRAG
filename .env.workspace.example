# Fresh local-only workspace values. Replace every credential before hosting.
# Use generated hexadecimal owner/reader passwords (URL-safe).
WORKSPACE_ADMIN_PASSWORD=local-res638-admin-only
WORKSPACE_DB_PASSWORD=0123456789abcdef0123456789abcdef0123456789abcdef
WORKSPACE_AGENT_PASSWORD=9876543210abcdef9876543210abcdef9876543210abcdef
WORKSPACE_READER_PASSWORD=abcdef0123456789abcdef0123456789abcdef0123456789
WORKSPACE_QDRANT_KEY=replace-with-a-new-random-qdrant-key
WORKSPACE_SEARCH_PASSWORD=Local-res638-search-only-1A
DYNAMISRAG_DATABASE_URL=postgresql://workspace_reader:abcdef0123456789abcdef0123456789abcdef0123456789@127.0.0.1:55438/workspace
DYNAMISRAG_AGENT_DATABASE_URL=postgresql://workspace_owner:9876543210abcdef9876543210abcdef9876543210abcdef@127.0.0.1:55439/workspace
DYNAMISRAG_OPENSEARCH_URL=https://127.0.0.1:19238
DYNAMISRAG_OPENSEARCH_PASSWORD=Local-res638-search-only-1A
DYNAMISRAG_OPENSEARCH_USERNAME=admin
DYNAMISRAG_OPENSEARCH_VERIFY_TLS=false
DYNAMISRAG_AGENT_ENABLED=true
DYNAMISRAG_AGENT_PROVIDER=opencode_go
DYNAMISRAG_AGENT_OPENCODE_GO_USAGE_APPROVED=false
DYNAMISRAG_AGENT_MODEL_FAST=deepseek-v4.1-flash
DYNAMISRAG_AGENT_MODEL_COORDINATOR=gpt-6-luna
DYNAMISRAG_AGENT_MODEL_PRO=deepseek-v4-pro
DYNAMISRAG_AGENT_RUN_COST_BUDGET_USD=0.20
DYNAMISRAG_AGENT_RUN_TOKEN_BUDGET=250000
DYNAMISRAG_AGENT_MAX_PRO_ESCALATIONS=1
DYNAMISRAG_AGENT_RATE_LIMIT_PER_MINUTE=60
DYNAMISRAG_AGENT_IDENTITY_SECRET=replace-with-a-new-random-secret-at-least-32-characters
DYNAMISRAG_AGENT_INLINE_WORKERS=0
DYNAMISRAG_SCIENTIFIC_ANSWERS_ENABLED=false
# Hosted Qdrant remains off until a fresh projection is qualified.
# An external URL requires HTTPS, its exact hostname, and a read-only API key.
# DYNAMISRAG_SCIENTIFIC_QDRANT_URL=https://your-free-cluster.cloud.qdrant.io:6333
# DYNAMISRAG_SCIENTIFIC_QDRANT_ALLOWED_REMOTE_HOST=your-free-cluster.cloud.qdrant.io
# DYNAMISRAG_SCIENTIFIC_QDRANT_API_KEY=
DYNAMISRAG_ENVIRONMENT=local
# API/worker intentionally refuse startup until provider usage is approved.
# For loopback deterministic integration checks only, set AGENT_PROVIDER=deterministic.
